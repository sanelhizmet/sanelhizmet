# Site adresi (canlı domain)
NEXT_PUBLIC_SITE_URL=https://sanelhizmet.com

# Google Search Console doğrulama
# Search Console > Sahiplik doğrulama > HTML etiketi içindeki content="..." değeri
GOOGLE_SITE_VERIFICATION=

# Google Places API Key (yorumları canlı çekmek için)
# Google Cloud Console > Places API (legacy Place Details) etkinleştirin
# https://console.cloud.google.com/apis/library/places-backend.googleapis.com
GOOGLE_PLACES_API_KEY=
